# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk (or run: clerk env pull) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Only needed for the optional billing-webhook segment:
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer-role token, used by the app's reads AND the Sanity Context MCP connection:
SANITY_API_READ_TOKEN=
# Editor-role token - server actions + the seed script only. Server-side only:
SANITY_API_WRITE_TOKEN=
# https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>
SANITY_CONTEXT_MCP_BASE_URL=

# --- AI ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5. Point a cost-sensitive deployment
# (e.g. a public portfolio demo) at a cheaper tier, e.g. claude-haiku-4-5-20251001
ANTHROPIC_AGENT_MODEL=
# Optional. Messages a single org can send the AI agent per UTC day. Defaults
# to 10 - a cost-control safety net, not a billing feature (every org gets the
# same cap regardless of plan). See lib/agent-rate-limit.ts.
AGENT_DAILY_MESSAGE_LIMIT=
